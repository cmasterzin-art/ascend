<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/widget_track"/>
            <corners android:radius="4dp"/>
            <stroke android:width="1dp" android:color="@color/widget_accent"/>
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <gradient android:startColor="@color/widget_primary" android:endColor="@color/widget_track" android:angle="270"/>
                    <corners android:radius="4dp"/>
                    <stroke android:width="0.9dp" android:color="@color/widget_accent"/>
                </shape>
            </item>
            <!-- 1.6.9.15: Left vertical forged bronze inlay bar marking an actionable ritual -->
            <item android:left="0dp" android:top="0dp" android:bottom="0dp" android:gravity="left">
                <shape>
                    <size android:width="4dp"/>
                    <solid android:color="@color/widget_accent"/>
                    <corners android:topLeftRadius="4dp" android:bottomLeftRadius="4dp"/>
                </shape>
            </item>
            <!-- Subtle top specular bevel -->
            <item android:top="1dp" android:left="6dp" android:right="4dp" android:gravity="top">
                <shape>
                    <size android:height="1dp"/>
                    <solid android:color="#28FFF1D6"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
