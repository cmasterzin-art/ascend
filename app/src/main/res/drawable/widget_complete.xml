<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/widget_track"/>
            <corners android:radius="4dp"/>
            <stroke android:width="1dp" android:color="@color/widget_accent"/>
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
        <shape>
            <gradient android:startColor="@color/widget_primary" android:endColor="@color/widget_track" android:angle="270"/>
            <corners android:radius="4dp"/>
            <stroke android:width="1dp" android:color="@color/widget_accent"/>
        </shape>
            </item>
            <!-- 1.6.9.10: bronze bevel highlight for the primary action. -->
            <item android:top="1dp" android:left="3dp" android:right="3dp" android:gravity="top">
                <shape>
                    <size android:height="1dp"/>
                    <solid android:color="#33FFF1D6"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
