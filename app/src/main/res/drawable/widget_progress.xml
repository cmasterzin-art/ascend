<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="@color/widget_track"/>
            <corners android:radius="2dp"/>
            <stroke android:width="0.5dp" android:color="@color/widget_stroke"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <gradient android:startColor="@color/widget_accent" android:endColor="@color/widget_glacier" android:angle="0"/>
                <corners android:radius="2dp"/>
            </shape>
        </clip>
    </item>
</layer-list>
