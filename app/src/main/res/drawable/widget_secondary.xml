<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/widget_track"/>
            <corners android:radius="4dp"/>
            <stroke android:width="1dp" android:color="@color/widget_accent"/>
        </shape>
    </item>
    <!-- 1.6.9.10: a recessed iron button; a faint top bevel replaces the flat fill. -->
    <item>
        <layer-list>
            <item>
                <shape>
                    <gradient android:startColor="@color/widget_button" android:endColor="@color/widget_track" android:angle="270"/>
                    <corners android:radius="4dp"/>
                    <stroke android:width="1dp" android:color="@color/widget_stroke"/>
                </shape>
            </item>
            <item android:top="1dp" android:left="3dp" android:right="3dp" android:gravity="top">
                <shape>
                    <size android:height="1dp"/>
                    <solid android:color="#22FFFFFF"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
