<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/widget_track"/>
            <corners android:radius="4dp"/>
            <stroke android:width="1dp" android:color="@color/widget_accent"/>
        </shape>
    </item>
    <!-- 1.6.9.15: recessed iron strip with glacier-steel left inlay bar -->
    <item>
        <layer-list>
            <item>
                <shape>
                    <gradient android:startColor="@color/widget_button" android:endColor="@color/widget_track" android:angle="270"/>
                    <corners android:radius="4dp"/>
                    <stroke android:width="0.9dp" android:color="@color/widget_stroke"/>
                </shape>
            </item>
            <item>
                <bitmap android:src="@drawable/ui_plate_secondary" android:gravity="fill" android:alpha="0.34"/>
            </item>
            <item android:left="0dp" android:top="0dp" android:bottom="0dp" android:gravity="left">
                <shape>
                    <size android:width="3dp"/>
                    <solid android:color="@color/widget_glacier"/>
                    <corners android:topLeftRadius="4dp" android:bottomLeftRadius="4dp"/>
                </shape>
            </item>
            <item android:top="1dp" android:left="5dp" android:right="4dp" android:gravity="top">
                <shape>
                    <size android:height="1dp"/>
                    <solid android:color="#22FFFFFF"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
