<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/widget_base"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
    <item>
        <bitmap android:src="@drawable/widget_slate" android:gravity="fill" android:alpha="0.45"/>
    </item>
    <item android:top="1dp" android:left="14dp" android:right="14dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <size android:height="2dp"/>
            <solid android:color="@color/widget_accent"/>
        </shape>
    </item>
    <item android:top="2dp">
        <shape>
            <solid android:color="#00000000"/>
            <corners android:radius="6dp"/>
            <stroke android:width="1dp" android:color="@color/widget_stroke"/>
        </shape>
    </item>
</layer-list>
