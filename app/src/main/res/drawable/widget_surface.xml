<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/widget_base"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
    <item>
        <bitmap android:src="@drawable/widget_slate" android:gravity="fill" android:alpha="0.18"/>
    </item>
    <!-- 1.6.9.10: cold light from above and a shadowed foot give the slate physical depth. -->
    <item>
        <shape>
            <gradient android:startColor="#1FC8D4E2" android:centerColor="#00000000" android:endColor="#47000000" android:angle="270"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#00000000"/>
            <corners android:radius="6dp"/>
            <stroke android:width="1.2dp" android:color="@color/widget_stroke"/>
        </shape>
    </item>
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape>
            <solid android:color="#00000000"/>
            <corners android:radius="4dp"/>
            <stroke android:width="0.6dp" android:color="@color/widget_accent"/>
        </shape>
    </item>
</layer-list>
