<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_surface">
 <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
  <ImageView android:id="@+id/widget_sigil" android:layout_width="20dp" android:layout_height="24dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_sigil" android:importantForAccessibility="no"/>
  <TextView android:id="@+id/widget_header" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="ASCEND" android:textColor="@color/widget_accent" android:fontFamily="serif" android:textStyle="bold" android:textSize="16sp" android:gravity="center_vertical" android:maxLines="1" android:contentDescription="Abrir Jornada do ASCEND"/>
  <TextView android:id="@+id/widget_open" android:layout_width="64dp" android:layout_height="48dp" android:text="Abrir\nJornada" android:textColor="@color/widget_text" android:textSize="11sp" android:gravity="center" android:background="@drawable/widget_secondary" android:contentDescription="Abrir Jornada"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_numbers" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp" android:paddingBottom="4dp">
  <TextView android:id="@+id/widget_percent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textSize="32sp" android:fontFamily="serif" android:textColor="@color/widget_text"/>
  <TextView android:id="@+id/widget_period" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingStart="14dp" android:textSize="11sp" android:textColor="@color/widget_muted"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Abra sua jornada para começar." android:textColor="@color/widget_text" android:textSize="12sp" android:maxLines="2"/>
 <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="7dp" android:layout_marginBottom="5dp" android:progressDrawable="@drawable/widget_progress"/>
 <TextView android:id="@+id/widget_stats" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_marginBottom="6dp" android:textColor="@color/widget_muted" android:textSize="11sp"/>
 <Button android:visibility="gone" android:id="@+id/widget_habit1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="48dp" android:padding="9dp" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" android:textAllCaps="false" android:stateListAnimator="@null" android:background="@drawable/widget_complete" android:textColor="@color/widget_action_text"/>
 <Button android:visibility="gone" android:id="@+id/widget_habit2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="48dp" android:padding="9dp" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" android:textAllCaps="false" android:stateListAnimator="@null" android:background="@drawable/widget_complete" android:textColor="@color/widget_action_text"/>
 <Button android:visibility="gone" android:id="@+id/widget_habit3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="48dp" android:padding="9dp" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" android:textAllCaps="false" android:stateListAnimator="@null" android:background="@drawable/widget_complete" android:textColor="@color/widget_action_text"/>
</LinearLayout>
