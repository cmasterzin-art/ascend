<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_surface">
 <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:orientation="horizontal" android:gravity="center_vertical">
  <ImageView android:id="@+id/widget_sigil" android:layout_width="18dp" android:layout_height="22dp" android:layout_marginEnd="7dp" android:src="@drawable/widget_sigil" android:importantForAccessibility="no"/>
  <TextView android:id="@+id/widget_header" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="ASCEND" android:textColor="@color/widget_accent" android:fontFamily="serif" android:textStyle="bold" android:letterSpacing="0.06" android:textSize="15sp" android:gravity="center_vertical" android:maxLines="1" android:contentDescription="Abrir Jornada do ASCEND"/>
  <TextView android:id="@+id/widget_open" android:layout_width="64dp" android:layout_height="32dp" android:text="Jornada ›" android:textColor="@color/widget_text" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:gravity="center" android:background="@drawable/widget_secondary" android:contentDescription="Abrir Jornada"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_numbers" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="2dp">
  <TextView android:id="@+id/widget_percent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textSize="30sp" android:fontFamily="serif" android:textStyle="bold" android:textColor="@color/widget_text"/>
  <TextView android:id="@+id/widget_period" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingStart="12dp" android:lineSpacingExtra="2dp" android:textSize="11sp" android:textColor="@color/widget_muted"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Abra sua jornada para começar." android:textColor="@color/widget_text" android:fontFamily="sans-serif-medium" android:textSize="12sp" android:maxLines="2"/>
 <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp" android:layout_marginBottom="4dp" android:progressDrawable="@drawable/widget_progress"/>
 <TextView android:id="@+id/widget_stats" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_marginBottom="5dp" android:textColor="@color/widget_accent" android:fontFamily="serif" android:textSize="11sp"/>
 <Button android:visibility="gone" android:id="@+id/widget_habit1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:minHeight="48dp" android:gravity="center_vertical|start" android:paddingStart="14dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:fontFamily="sans-serif-medium" android:textSize="12.5sp" android:maxLines="2" android:ellipsize="end" android:textAllCaps="false" android:stateListAnimator="@null" android:background="@drawable/widget_complete" android:textColor="@color/widget_action_text"/>
 <Button android:visibility="gone" android:id="@+id/widget_habit2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:minHeight="48dp" android:gravity="center_vertical|start" android:paddingStart="14dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:fontFamily="sans-serif-medium" android:textSize="12.5sp" android:maxLines="2" android:ellipsize="end" android:textAllCaps="false" android:stateListAnimator="@null" android:background="@drawable/widget_complete" android:textColor="@color/widget_action_text"/>
 <Button android:visibility="gone" android:id="@+id/widget_habit3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:minHeight="48dp" android:gravity="center_vertical|start" android:paddingStart="14dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:fontFamily="sans-serif-medium" android:textSize="12.5sp" android:maxLines="2" android:ellipsize="end" android:textAllCaps="false" android:stateListAnimator="@null" android:background="@drawable/widget_complete" android:textColor="@color/widget_action_text"/>
</LinearLayout>
